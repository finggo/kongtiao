{
  "rewrites": [
    { "source": "/api/upload", "destination": "/api/upload.js" },
    { "source": "/", "destination": "/kongtiao.html" }  // 新增：根域名指向kongtiao.html
  ],
  "headers": [
    {
      "source": "/public/data.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}